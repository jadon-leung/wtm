// Copy this file to Secrets.xcconfig (gitignored) and fill in your Supabase
// project's values: Project Settings -> API in the Supabase dashboard.
//
// xcconfig treats `//` inside a value as the start of a comment, so a
// literal `//` in the URL is escaped as `/$()/`.

SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = your-anon-key-here
